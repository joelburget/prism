import Data.List (..)
import Data.Foldable (..)
import Data.String (..)
import Data.Result (..)
import Domain (..)

pub fn new_service() : MockService = MockService { calls = [], effects = [] }

fn audit(service : MockService, worker : Option(String), ticket : Option(Int), kind : CallKind, key : ActionKey, attempt : Int, outcome : CallOutcome) : MockService =
  MockService { ..service, calls = append(service.calls,
    [ServiceCall { worker = worker, ticket = ticket, kind = kind, key = key, attempt = attempt, outcome = outcome }]) }

fn has_effect(service : MockService, key : ActionKey) : Bool =
  any(\(entry) -> entry.key == key, service.effects)

-- The per-key failure counter is the number of transient execute responses already
-- audited for that key. Lookups never touch it.
fn transient_count(service : MockService, key : ActionKey) : Int =
  count(\(call) -> call.kind == ExecuteCall && call.outcome == Transient && call.key == key, service.calls)

-- Atomic execute: replay an existing effect, fail transiently while the configured
-- failure budget remains, otherwise record exactly one effect. Every call is audited.
-- The worker/ticket pair only labels the audit entry; it never affects the outcome.
pub fn execute_as(service : MockService, worker : Option(String), ticket : Option(Int), key : ActionKey, amount : Int, attempt : Int, failures : Int) : (MockService, CallOutcome) =
  if has_effect(service, key) then
    (audit(service, worker, ticket, ExecuteCall, key, attempt, Replayed), Replayed)
  elif transient_count(service, key) < failures then
    (audit(service, worker, ticket, ExecuteCall, key, attempt, Transient), Transient)
  else
    let applied = MockService { ..service, effects = append(service.effects, [Effect { key = key, amount = amount }]) }
    (audit(applied, worker, ticket, ExecuteCall, key, attempt, Applied), Applied)

-- Atomic lookup: reports whether an effect exists without ever creating one.
pub fn lookup_as(service : MockService, worker : Option(String), ticket : Option(Int), key : ActionKey, attempt : Int) : (MockService, CallOutcome) =
  let outcome = if has_effect(service, key) then Found else Missing
  (audit(service, worker, ticket, LookupCall, key, attempt, outcome), outcome)

-- Legacy (checkpoint-one) entry points: unlabelled calls with identical semantics.
pub fn execute(service : MockService, key : ActionKey, amount : Int, attempt : Int, failures : Int) : (MockService, CallOutcome) =
  execute_as(service, None, None, key, amount, attempt, failures)

pub fn lookup(service : MockService, key : ActionKey, attempt : Int) : (MockService, CallOutcome) =
  lookup_as(service, None, None, key, attempt)
