import Data.List (..)
import Data.Foldable (..)
import Data.String (..)
import Data.Result (..)
import Domain (..)
import Service (..)

pub fn new_simulator() : Simulator =
  Simulator { now = 0, up = true, runs = [], service = new_service(), observations = [] }

pub fn snapshot(sim : Simulator) : Snapshot =
  -- Persistent values make every historical snapshot independent of later updates.
  Snapshot { now = sim.now, up = sim.up, runs = sim.runs }

fn new_step(now : Int, definition : StepDefinition) : StepState =
  StepState { id = definition.id, status = Pending, attempts = 0, ready_at = now }

fn terminal(status : RunStatus) : Bool =
  status == RunSucceeded || status == RunFailed || status == RunCancelled

fn select_step(now : Int, inflight : Bool, run : RunState, states : List(StepState), definitions : List(StepDefinition)) : Option(Action) =
  match (states, definitions) of
    (Cons(step, more_states), Cons(definition, more_definitions)) =>
      let ready =
        if inflight then step.status == Running
        else run.status == RunActive && step.status == Pending && step.ready_at <= now
          && all(\(dep) -> any(\(s) -> s.id == dep && s.status == Succeeded, run.steps), definition.needs)
      if ready then Some(Action { run = run, step = step, definition = definition })
      else select_step(now, inflight, run, more_states, more_definitions)
    _ => None

fn select_run(now : Int, inflight : Bool, runs : List(RunState), definitions : List(StepDefinition)) : Option(Action) =
  match runs of
    Nil => None
    Cons(run, rest) =>
      match select_step(now, inflight, run, run.steps, definitions) of
        Some(action) => Some(action)
        None => select_run(now, inflight, rest, definitions)

pub fn select_action(sim : Simulator, workflow : Workflow) : Option(Action) =
  -- Resume the oldest in-flight attempt before scanning ready pending work.
  match select_run(sim.now, true, sim.runs, workflow.steps) of
    Some(action) => Some(action)
    None => select_run(sim.now, false, sim.runs, workflow.steps)

fn replace_step(run : RunState, replacement : StepState) : RunState =
  RunState { ..run, steps = map(\(step) -> if step.id == replacement.id then replacement else step, run.steps) }

fn replace_run(sim : Simulator, replacement : RunState) : Simulator =
  Simulator { ..sim, runs = map(\(run) -> if run.id == replacement.id then replacement else run, sim.runs) }

fn mark_pending(run : RunState, status : StepStatus) : RunState =
  RunState { ..run, steps = map(\(step) -> if step.status == Pending then StepState { ..step, status = status } else step, run.steps) }

fn find_run(sim : Simulator, id : String) : Option(RunState) =
  find(\(run) -> run.id == id, sim.runs)

-- Commit a successful (applied or replayed) execute response.
fn commit_success(run : RunState, step : StepState) : RunState =
  let completed = replace_step(run, StepState { ..step, status = Succeeded })
  if all(\(s) -> s.status == Succeeded, completed.steps) then RunState { ..completed, status = RunSucceeded }
  else completed

-- Commit a transient execute response: schedule a retry or exhaust the budget.
fn commit_transient(sim : Simulator, workflow : Workflow, run : RunState, step : StepState) : Result(RunState, String) =
  if step.attempts < workflow.max_attempts then
    let deadline = sim.now + workflow.retry_delay
    if deadline > time_limit() then Err("TIME_OVERFLOW")
    else Ok(replace_step(run, StepState { ..step, status = Pending, ready_at = deadline }))
  else
    let failed = replace_step(run, StepState { ..step, status = Failed })
    Ok(RunState { ..mark_pending(failed, Blocked), status = RunFailed })

-- Commit a cancellation lookup: found effects are kept, missing ones are cancelled.
fn commit_lookup(run : RunState, step : StepState, outcome : CallOutcome) : RunState =
  let status = if outcome == Found then Succeeded else Cancelled
  RunState { ..replace_step(run, StepState { ..step, status = status }), status = RunCancelled }

fn crash_now(sim : Simulator) : Simulator = Simulator { ..sim, up = false }

pub fn tick(sim : Simulator, workflow : Workflow, checkpoint : Option(Checkpoint)) : Result(Simulator, String) =
  match select_action(sim, workflow) of
    None => Ok(sim)
    Some(action) =>
      -- Beginning an attempt is durable; a recovered attempt keeps its number and key.
      let running =
        if action.step.status == Pending then
          StepState { ..action.step, status = Running, attempts = action.step.attempts + 1 }
        else action.step
      let begun_run = replace_step(action.run, running)
      let begun = replace_run(sim, begun_run)
      if checkpoint == Some(AfterBegin) then Ok(crash_now(begun))
      else
        let key = ActionKey { run_id = action.run.id, step_id = running.id }
        let reconciling = begun_run.status == RunCancelling
        let response =
          if reconciling then lookup(begun.service, key, running.attempts)
          else execute(begun.service, key, action.definition.amount, running.attempts, action.definition.failures)
        let called = Simulator { ..begun, service = fst(response) }
        let outcome = snd(response)
        -- The service response and effect are atomic; the crash window is before the commit.
        if checkpoint == Some(AfterCall) then Ok(crash_now(called))
        else
          let committed =
            if reconciling then Ok(commit_lookup(begun_run, running, outcome))
            elif outcome == Transient then commit_transient(called, workflow, begun_run, running)
            else Ok(commit_success(begun_run, running))
          let finished = committed?
          Ok(replace_run(called, finished))

fn cancel(sim : Simulator, run : RunState) : Simulator =
  if terminal(run.status) then sim
  else
    let cancelled = mark_pending(run, Cancelled)
    let status = if any(\(step) -> step.status == Running, cancelled.steps) then RunCancelling else RunCancelled
    replace_run(sim, RunState { ..cancelled, status = status, cancel_requested = true })

pub fn apply_command(sim : Simulator, workflow : Workflow, command : Command) : Result(Simulator, String) =
  match command of
    Start(id) =>
      if not(sim.up) then Err("PROCESS_DOWN")
      elif any(\(run) -> run.id == id, sim.runs) then Err("DUPLICATE_RUN")
      else
        let run = RunState { id = id, status = RunActive, cancel_requested = false,
          steps = map(\(definition) -> new_step(sim.now, definition), workflow.steps) }
        Ok(Simulator { ..sim, runs = append(sim.runs, [run]) })
    Tick(checkpoint) =>
      if not(sim.up) then Err("PROCESS_DOWN")
      else tick(sim, workflow, checkpoint)
    Advance(by) =>
      if sim.now + by > time_limit() then Err("TIME_OVERFLOW")
      else Ok(Simulator { ..sim, now = sim.now + by })
    Observe => Ok(Simulator { ..sim, observations = append(sim.observations, [snapshot(sim)]) })
    Crash =>
      if not(sim.up) then Err("PROCESS_DOWN")
      else Ok(crash_now(sim))
    Restart =>
      if sim.up then Err("PROCESS_UP")
      else Ok(Simulator { ..sim, up = true })
    Cancel(id) =>
      if not(sim.up) then Err("PROCESS_DOWN")
      else
        match find_run(sim, id) of
          None => Err("UNKNOWN_RUN")
          Some(run) => Ok(cancel(sim, run))

fn run_commands(sim : Simulator, workflow : Workflow, commands : List(Command)) : Result(Simulator, String) =
  match commands of
    Nil => Ok(sim)
    Cons(command, rest) =>
      let next = apply_command(sim, workflow, command)?
      run_commands(next, workflow, rest)

pub fn simulate(workflow : Workflow) : Result(Simulator, String) =
  run_commands(new_simulator(), workflow, workflow.commands)
