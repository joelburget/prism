import Data.List (..)
import Data.Foldable (..)
import Data.String (..)
import Data.Result (..)
import Json (..)
import Domain (..)
import Validation (..)
import Runner (simulate)
import Output (response_json)

fn handle_request(line : String) : Result(Simulator, String) =
  let request = map_err(\(_) -> "INVALID_INPUT", decode_lossy(line))?
  let workflow = parse_request(request)?
  simulate(workflow)

fn main() = println(encode(response_json(handle_request(read_line()))))
