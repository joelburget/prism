import Data.List (..)
import Data.Foldable (..)
import Data.Result (..)
import Domain (..)
import Service (..)

pub fn new_simulator() : Simulator =
  Simulator { now = 0, up = true, runs = [], service = new_service(), observations = [] }

pub fn snapshot(sim : Simulator) : Snapshot = Snapshot { now = sim.now, up = sim.up, runs = sim.runs }
fn new_step(now : Int, definition : StepDefinition) : StepState = StepState { id = definition.id, status = Pending, attempts = 0, ready_at = now }

fn select_step(now : Int, inflight : Bool, run : RunState, states : List(StepState), definitions : List(StepDefinition)) : Option(Action) =
  match (states, definitions) of
    (Cons(step, more_states), Cons(definition, more_definitions)) =>
      let ready = if inflight then step.status == Running else (run.status == Active && step.status == Pending && step.ready_at <= now &&
        all(\(dep) -> any(\(s) -> s.id == dep && s.status == Succeeded, run.steps), definition.needs))
      if ready then Some(Action { run = run, step = step, definition = definition })
      else select_step(now, inflight, run, more_states, more_definitions)
    _ => None

fn select_run(now : Int, inflight : Bool, runs : List(RunState), definitions : List(StepDefinition)) : Option(Action) =
  match runs of
    Nil => None
    Cons(run, rest) => match select_step(now, inflight, run, run.steps, definitions) of
      Some(action) => Some(action)
      None => select_run(now, inflight, rest, definitions)

pub fn select_action(sim : Simulator, workflow : Workflow) : Option(Action) =
  match select_run(sim.now, true, sim.runs, workflow.steps) of
    Some(action) => Some(action)
    None => select_run(sim.now, false, sim.runs, workflow.steps)

fn replace_step(run : RunState, replacement : StepState) : RunState =
  RunState { ..run, steps = map(\(step) -> if step.id == replacement.id then replacement else step, run.steps) }
fn replace_run(sim : Simulator, replacement : RunState) : Simulator =
  Simulator { ..sim, runs = map(\(run) -> if run.id == replacement.id then replacement else run, sim.runs) }
fn down(sim : Simulator) : Simulator = Simulator { ..sim, up = false }
fn all_succeeded(steps : List(StepState)) : Bool = all(\(step) -> step.status == Succeeded, steps)
fn terminal(status : RunStatus) : Bool = status == Completed || status == FailedRun || status == CancelledRun

fn resolve_cancelled(sim : Simulator, run : RunState, running : StepState, outcome : LookupOutcome) : Simulator =
  let resolved = StepState { ..running, status = if outcome == Found then Succeeded else Cancelled }
  let cancelled = RunState { ..replace_step(run, resolved), status = CancelledRun }
  replace_run(sim, cancelled)

fn fail_run(sim : Simulator, run : RunState, failed : StepState) : Simulator =
  let with_failed = replace_step(run, failed)
  let blocked = RunState { ..with_failed, status = FailedRun,
    steps = map(\(step) -> if step.status == Pending then StepState { ..step, status = Blocked } else step, with_failed.steps) }
  replace_run(sim, blocked)

fn commit_success(sim : Simulator, run : RunState, running : StepState) : Simulator =
  let completed = replace_step(run, StepState { ..running, status = Succeeded })
  let finished = if all_succeeded(completed.steps) then RunState { ..completed, status = Completed } else completed
  replace_run(sim, finished)

fn tick_action(sim : Simulator, workflow : Workflow, action : Action, checkpoint : Option(Checkpoint)) : Result(Simulator, String) =
  let running = if action.step.status == Pending then StepState { ..action.step, status = Running, attempts = action.step.attempts + 1 } else action.step
  let begun_run = replace_step(action.run, running)
  let begun = replace_run(sim, begun_run)
  if checkpoint == Some(AfterBegin) then Ok(down(begun))
  else
    let key = ActionKey { run_id = action.run.id, step_id = running.id }
    if action.run.status == Cancelling then
      let (service, outcome) = lookup(begun.service, key, running.attempts)
      let called = Simulator { ..begun, service = service }
      if checkpoint == Some(AfterCall) then Ok(down(called))
      else Ok(resolve_cancelled(called, begun_run, running, outcome))
    else
      let (service, outcome) = execute(begun.service, key, action.definition.amount, running.attempts, action.definition.failures)
      let called = Simulator { ..begun, service = service }
      if checkpoint == Some(AfterCall) then Ok(down(called))
      else match outcome of
        Applied => Ok(commit_success(called, begun_run, running))
        Replayed => Ok(commit_success(called, begun_run, running))
        Transient =>
          if running.attempts < workflow.max_attempts then
            if called.now + workflow.retry_delay > time_limit() then Err("TIME_OVERFLOW")
            else Ok(replace_run(called, replace_step(begun_run,
              StepState { ..running, status = Pending, ready_at = called.now + workflow.retry_delay })))
          else Ok(fail_run(called, begun_run, StepState { ..running, status = Failed }))

pub fn tick(sim : Simulator, workflow : Workflow, checkpoint : Option(Checkpoint)) : Result(Simulator, String) =
  match select_action(sim, workflow) of
    None => Ok(sim)
    Some(action) => tick_action(sim, workflow, action, checkpoint)

fn cancel_run(sim : Simulator, id : String) : Result(Simulator, String) =
  match find(\(run) -> run.id == id, sim.runs) of
    None => Err("UNKNOWN_RUN")
    Some(run) =>
      if terminal(run.status) then Ok(sim)
      else
        let cancelled_steps = map(\(step) -> if step.status == Pending then StepState { ..step, status = Cancelled } else step, run.steps)
        let has_running = any(\(step) -> step.status == Running, cancelled_steps)
        let changed = RunState { ..run, cancel_requested = true, steps = cancelled_steps,
          status = if has_running then Cancelling else CancelledRun }
        Ok(replace_run(sim, changed))

pub fn apply_command(sim : Simulator, workflow : Workflow, command : Command) : Result(Simulator, String) =
  match command of
    Advance(by) => if sim.now + by > time_limit() then Err("TIME_OVERFLOW") else Ok(Simulator { ..sim, now = sim.now + by })
    Observe => Ok(Simulator { ..sim, observations = append(sim.observations, [snapshot(sim)]) })
    Restart => if sim.up then Err("PROCESS_UP") else Ok(Simulator { ..sim, up = true })
    _ =>
      if not(sim.up) then Err("PROCESS_DOWN")
      else match command of
        Start(id) => if any(\(run) -> run.id == id, sim.runs) then Err("DUPLICATE_RUN") else
          let run = RunState { id = id, status = Active, cancel_requested = false, steps = map(\(definition) -> new_step(sim.now, definition), workflow.steps) }
          Ok(Simulator { ..sim, runs = append(sim.runs, [run]) })
        Tick(checkpoint) => tick(sim, workflow, checkpoint)
        Crash => Ok(down(sim))
        Cancel(id) => cancel_run(sim, id)
        _ => Err("INVALID_INPUT")

fn run_commands(sim : Simulator, workflow : Workflow, commands : List(Command)) : Result(Simulator, String) =
  match commands of
    Nil => Ok(sim)
    Cons(command, rest) =>
      let next = apply_command(sim, workflow, command)?
      run_commands(next, workflow, rest)
pub fn simulate(workflow : Workflow) : Result(Simulator, String) = run_commands(new_simulator(), workflow, workflow.commands)
